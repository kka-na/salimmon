# Copy to server/.env (real environment variables take precedence).
# Relative paths are resolved from the repository root.

# Research Markdown source of truth. Use samples/research for the test-only demo data.
RESEARCH_DIR=research
# Personal data (stamps, notes, quotes). PostgreSQL also works: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///server/data/salimmon.db
# Comma-separated browser origins allowed to call the API directly (the Next.js proxy does not need this).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Re-read research/*.md automatically when files change (dev convenience).
RESEARCH_WATCH=true
# Prices older than this many days are labelled "재확인 필요".
STALE_PRICE_DAYS=180
# Enables POST /api/admin/reload (used by the import CLI and the data report page).
ENABLE_ADMIN=true
